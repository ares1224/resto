# Variables d'environnement — copier en .env.local pour le développement,
# et reporter les valeurs dans Vercel > Settings > Environment Variables.
#
# Compte super-admin (propriétaire de la plateforme). Créé uniquement s'il
# n'existe pas encore. Changez le mot de passe dès la première connexion.
SUPERADMIN_EMAIL=admin@platform.local
SUPERADMIN_PASSWORD=ChangeMe123!

# URL publique (liens dans les emails). Obligatoire sur Vercel.
NEXT_PUBLIC_APP_URL=https://resto-7c0aep0pf-ares-548f.vercel.app
APP_URL=https://resto-7c0aep0pf-ares-548f.vercel.app

# Envoi d'emails via Resend (obligatoire en production).
# Copiez la clé dans .env.local ET dans Vercel > Settings > Environment Variables.
RESEND_API_KEY=
RESEND_FROM=Gestion restaurant <beth.t@example.com>
PLATFORM_NAME=Gestion restaurant

# Clé unique pour la route temporaire /api/setup/create-super-admin
# À définir dans Vercel > Settings > Environment Variables (Production).
# SETUP_SECRET_KEY=

# Télémétrie Next.js désactivée (logs de build Vercel plus propres).
NEXT_TELEMETRY_DISABLED=1

# Stockage persistant (obligatoire sur Vercel).
# Créez un Blob store privé : projet Vercel → Storage → Create Database → Blob (Private),
# connectez-le au projet. BLOB_READ_WRITE_TOKEN et BLOB_STORE_ID sont injectés automatiquement.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
