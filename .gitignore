# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# base de données locale : comptes, mots de passe et données personnelles réelles.
# Ne doit jamais partir sur GitHub. Le fichier est recréé vide au démarrage.
/data/
*.tmp

# robot MQL5 hors sujet — reste en local
/mql5/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
